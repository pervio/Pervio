<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — nothing installs this. Substitute __REPO__ with your checkout and
  copy it into ~/Library/LaunchAgents; the exact commands (and the uninstall)
  are in docs/testing.md.

      sed "s|__REPO__|$PWD|g" scripts/launchd/app.pervio.nightly-tests.plist.template \
        > ~/Library/LaunchAgents/app.pervio.nightly-tests.plist

  A LaunchAgent (not a Daemon) on purpose: xcodebuild + the iOS Simulator need
  the logged-in GUI session. The Mac must be awake at the scheduled time — if it
  is asleep, launchd runs the job on the next wake instead.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.pervio.nightly-tests</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/nightly-tests.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- launchd hands a job a bare PATH; xcodegen (Homebrew) would not be found. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <!-- Loading the job must not kick off an hour of tests on the spot. -->
  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- The run's own report is ~/.pervio/test-reports/<date>.log; these two catch
       whatever escapes it (a crashed shell, a launchd complaint). -->
  <key>StandardOutPath</key>
  <string>/tmp/pervio-nightly-tests.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pervio-nightly-tests.launchd.log</string>
</dict>
</plist>
