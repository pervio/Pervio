#!/usr/bin/env bash
# Pervio pre-push hook — TEMPLATE. Nothing installs this for you; you opt in with
#
#     git config core.hooksPath .githooks
#
# and opt out with `git config --unset core.hooksPath`. See docs/testing.md.
#
# It runs scripts/test-fast.sh and blocks the push on red. Deleting a branch
# (nothing new is being pushed) skips the run. `git push --no-verify` bypasses
# the hook entirely — for a genuine emergency, not for a habit.
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ]; then
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"    # only when run outside a work tree
fi

# stdin is "<local ref> <local sha> <remote ref> <remote sha>" per ref. An
# all-zero local sha means a delete, which builds nothing.
have_work=0
while read -r _lref lsha _rref _rsha; do
  case "$lsha" in
    ""|0000000000000000000000000000000000000000) ;;
    *) have_work=1;;
  esac
done
if [ "$have_work" = 0 ]; then
  echo "pre-push: nothing but deletes — skipping tests"
  exit 0
fi

echo "pre-push: running scripts/test-fast.sh (bypass with --no-verify)"
if bash "$ROOT/scripts/test-fast.sh"; then
  exit 0
fi

cat >&2 <<'MSG'

################################################################
# push BLOCKED — scripts/test-fast.sh is red (see RESULT above).
# Fix it, or, if you truly must:  git push --no-verify
################################################################
MSG
exit 1
