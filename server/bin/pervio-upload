#!/usr/bin/env python3
"""pervio-upload — receive a phone-side file over SSH, in two steps.

The iOS app can only run one-shot SSH commands (no stdin piping), so a file is
transferred as base64 appended to a temp file in small chunks, then decoded:

    pervio-upload init [--bytes N]
        -> {"tmp": "<abs .b64 path>", "token": "<hex>", "dir": "<uploads dir>"
            [, "bytes": N]}
    # client: printf '%s' '<chunk>' >> <tmp>   (repeated, base64 is shell-safe)
    pervio-upload finish --tmp <tmp> --name <original-filename> [--bytes N]
        -> {"path": "<abs decoded file>", "bytes": N}   (or {"error": "..."})

Decoded files land in ~/.pervio/uploads/, which pervio-chat exposes to Claude's
Read tool via --add-dir, so the model can open them by path.

Integrity. The chunks are appended by a REMOTE SHELL, so whatever that shell
prints on a bad day lands in the same file, and a truncated transfer is still
perfectly valid base64. Two rules keep a damaged transfer from becoming a
plausible-looking document the model then reads as the user's:
  * decoding is strict (validate=True, after folding away line breaks) — stray
    bytes are an error, never silently dropped characters that shift the rest;
  * the decoded SIZE may be declared. `init --bytes N` records N inside the
    token the client hands back, so finish enforces a number the client cannot
    revise later; `finish --bytes N` alone is honoured when init declared
    nothing, and the two must agree when both are present. No declaration =
    the pre-existing behaviour, byte for byte (older clients keep working).

Containment. The uploads dir is shared-host territory, so --tmp is only ever a
name THIS tool minted (<32 hex>[.<declared>].b64) directly inside it. finish
used to resolve --tmp twice — once to containment-check it, once to open it —
which a symlink swapped between the two resolutions could redirect at any file
the owner can read. Now the DIRECTORY is resolved once and pinned as an fd, and
every step (open the temp, create the .part, rename, unlink) runs relative to
that fd with O_NOFOLLOW / O_EXCL: a symlink at the final component is refused
instead of followed, and there is no second path resolution left to race.
Requires POSIX openat/renameat (macOS + Linux).
"""
import os, sys, json, base64, binascii, uuid, re, stat, time, glob

HOME = os.path.expanduser("~")
UP = os.path.join(HOME, ".pervio", "uploads")
MAX_BYTES = 8 * 1024 * 1024          # decoded-file cap
MAX_B64 = 12 * 1024 * 1024           # temp-file cap (base64 is ~1.34x)
STALE_SECS = 3600                    # prune leftover temp files older than this (1h)
UPLOAD_TTL = 7 * 24 * 3600           # expire decoded uploads after this (7 days)

# A temp file we minted: the uuid4 token, an optional declared decoded size, and
# the .b64 suffix _gc prunes on the 1h clock.
TEMP_RE = re.compile(r"^([0-9a-f]{32})(?:\.([0-9]{1,9}))?\.b64$")
O_DIR = getattr(os, "O_DIRECTORY", 0)


def _gc():
    """Best-effort prune: stale temp files (aborted uploads), and decoded uploads
    older than UPLOAD_TTL so they don't pile up / stay readable forever."""
    now = time.time()
    try:
        entries = glob.glob(os.path.join(UP, "*"))
    except OSError:
        entries = []
    for fp in entries:
        try:
            if not os.path.isfile(fp):
                continue
            age = now - os.path.getmtime(fp)
            is_temp = fp.endswith(".b64") or fp.endswith(".part")
            limit = STALE_SECS if is_temp else UPLOAD_TTL
            if age > limit:
                os.remove(fp)
        except OSError:
            pass


def _safe_name(name):
    name = os.path.basename(name or "")
    name = re.sub(r"[^A-Za-z0-9._-]", "_", name).strip("._") or "file"
    return name[:80]


def _updir_fd():
    """An fd for the uploads dir. Every later step names files RELATIVE to it,
    so the directory is resolved exactly once per command."""
    return os.open(UP, os.O_RDONLY | O_DIR)


def _drop(dfd, name):
    """Unlink inside the uploads dir; never follows a symlink (unlink can't)."""
    try:
        os.unlink(name, dir_fd=dfd)
    except OSError:
        pass


def _create(dfd, name):
    """Create a file inside the uploads dir for writing. O_EXCL|O_NOFOLLOW so the
    write can never go THROUGH a planted symlink into someone else's file; a
    leftover from one of our own crashed runs is unlinked (which does not follow
    the link either) and the create retried exactly once."""
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    try:
        return os.open(name, flags, 0o600, dir_fd=dfd)
    except FileExistsError:
        os.unlink(name, dir_fd=dfd)
        return os.open(name, flags, 0o600, dir_fd=dfd)


def _temp_parts(path):
    """(basename, token, declared-bytes-or-None) iff `path` names a temp file
    this tool minted directly inside the uploads dir, else None. Only the
    DIRECTORY is resolved here; the final component is deliberately left
    unresolved — it is opened later with O_NOFOLLOW against the pinned fd."""
    if not path:
        return None
    m = TEMP_RE.match(os.path.basename(path))
    if not m:
        return None
    try:
        if os.path.realpath(os.path.dirname(path) or ".") != os.path.realpath(UP):
            return None
    except OSError:
        return None
    return m.group(0), m.group(1), (int(m.group(2)) if m.group(2) else None)


def cmd_init(declared=None):
    if declared is not None and declared > MAX_BYTES:
        # Refuse the impossible upload BEFORE the phone spends a transfer on it.
        print(json.dumps({"error": "file too large"})); return
    os.makedirs(UP, exist_ok=True)
    os.chmod(UP, 0o700)              # owner-only, even if the dir pre-existed loose
    _gc()                            # clear stale temps from past aborted uploads
    token = uuid.uuid4().hex
    base = token + ("" if declared is None else ".%d" % declared) + ".b64"
    tmp = os.path.join(UP, base)
    try:
        dfd = _updir_fd()
    except OSError as e:
        print(json.dumps({"error": "cannot open uploads dir: %s" % e.strerror})); return
    try:
        os.close(_create(dfd, base))
    except OSError as e:
        print(json.dumps({"error": "cannot create temp file: %s" % e.strerror})); return
    finally:
        os.close(dfd)
    out = {"tmp": tmp, "token": token, "dir": UP}
    if declared is not None:
        out["bytes"] = declared
    print(json.dumps(out))


def cmd_abort(tmp):
    """Remove a temp file for an upload the client gave up on."""
    ok = False
    parts = _temp_parts(tmp)
    if parts is not None:
        try:
            dfd = _updir_fd()
        except OSError:
            dfd = None
        if dfd is not None:
            try:
                os.unlink(parts[0], dir_fd=dfd); ok = True
            except OSError:
                ok = False
            finally:
                os.close(dfd)
    print(json.dumps({"aborted": ok}))


def cmd_finish(tmp, name, declared=None):
    # tmp must be a plain .b64 file we created inside the uploads dir.
    parts = _temp_parts(tmp)
    if parts is None:
        print(json.dumps({"error": "bad temp file"})); return
    base, token, init_bytes = parts
    try:
        dfd = _updir_fd()
    except OSError:
        print(json.dumps({"error": "bad temp file"})); return
    try:
        try:
            fd = os.open(base, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
        except OSError:
            print(json.dumps({"error": "bad temp file"})); return
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode):
                print(json.dumps({"error": "bad temp file"})); return
            if st.st_size > MAX_B64:
                _drop(dfd, base)
                print(json.dumps({"error": "file too large"})); return
            data = f.read()

        # What init recorded wins; --bytes at finish may only agree with it.
        expect = init_bytes
        if declared is not None:
            if expect is None:
                expect = declared
            elif declared != expect:
                _drop(dfd, base)
                print(json.dumps({"error": "size mismatch: %d declared at init, "
                                           "%d at finish" % (expect, declared)})); return
        try:
            # Fold away line breaks (a chunked transfer may carry them), then
            # decode STRICTLY: anything else in the stream is corruption, not a
            # character to skip over.
            raw = base64.b64decode(b"".join(data.split()), validate=True)
        except (binascii.Error, ValueError):
            _drop(dfd, base)
            print(json.dumps({"error": "corrupt upload data"})); return
        if len(raw) > MAX_BYTES:
            _drop(dfd, base)
            print(json.dumps({"error": "file too large"})); return
        if expect is not None and len(raw) != expect:
            _drop(dfd, base)
            print(json.dumps({"error": "size mismatch: expected %d bytes, got %d"
                                       % (expect, len(raw))})); return

        dest = token + "-" + _safe_name(name)
        part = dest + ".part"
        try:
            wfd = _create(dfd, part)
        except OSError as e:
            print(json.dumps({"error": "cannot write upload: %s" % e.strerror})); return
        try:
            with os.fdopen(wfd, "wb") as f:
                f.write(raw)
                f.flush()
                os.fsync(f.fileno())
            os.replace(part, dest, src_dir_fd=dfd, dst_dir_fd=dfd)   # atomic
        except OSError as e:
            _drop(dfd, part)         # never leave a half-written .part behind
            print(json.dumps({"error": "cannot write upload: %s" % e.strerror})); return
        _drop(dfd, base)
        print(json.dumps({"path": os.path.join(UP, dest), "bytes": len(raw)}))
    finally:
        os.close(dfd)


def main():
    os.umask(0o077)            # phone uploads are private to the owner (shared host)
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    opts, i = {}, 1
    while i < len(args):
        if args[i] in ("--tmp", "--name", "--bytes") and i + 1 < len(args):
            opts[args[i][2:]] = args[i + 1]; i += 2
        else:
            i += 1
    declared = opts.get("bytes")
    if declared is not None:
        if not re.fullmatch(r"[0-9]{1,9}", declared):
            print(json.dumps({"error": "bad --bytes"})); return
        declared = int(declared)
    if cmd == "init":
        cmd_init(declared)
    elif cmd == "finish":
        try:
            cmd_finish(opts.get("tmp", ""), opts.get("name", ""), declared)
        except Exception as e:
            print(json.dumps({"error": str(e)}))
    elif cmd == "abort":
        cmd_abort(opts.get("tmp", ""))
    else:
        print(json.dumps({"error": "usage: pervio-upload init|finish|abort"}))


if __name__ == "__main__":
    main()
