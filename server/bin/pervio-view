JS = """
(function(){
  var t = new URLSearchParams(location.search).get('t') || '';
  var toast = document.getElementById('toast'), timer = 0;
  function say(msg, bad){
    toast.textContent = msg;
    toast.className = bad ? 'toast bad show' : 'toast show';
    clearTimeout(timer);
    timer = setTimeout(function(){ toast.className = 'toast'; }, 4000);
  }
  document.addEventListener('click', function(e){
    var b = e.target.closest ? e.target.closest('button.act') : null;
    if (!b || b.disabled) return;
    var g = b.parentElement;
    if (!g || g.className.indexOf('acts') < 0) return;
    var body;
    try {
      body = JSON.stringify({
        actionIndex: parseInt(g.getAttribute('data-action'), 10),
        captureGroups: JSON.parse(g.getAttribute('data-groups')),
        choiceIndex: parseInt(b.getAttribute('data-choice'), 10)
      });
    } catch (err) { say('\\u8bfb\\u4e0d\\u51fa\\u9009\\u9879', true); return; }
    b.disabled = true;
    fetch('/score?t=' + encodeURIComponent(t), {
      method: 'POST', headers: {'Content-Type': 'application/json'}, body: body
    }).then(function(r){
      return r.json().catch(function(){ return {}; })
              .then(function(j){ return {s: r.status, j: j}; });
    }).then(function(o){
      b.disabled = false;
      if (o.s === 200 && o.j && o.j.ok) {
        g.className = 'acts done';
        say('\\u5df2\\u8bb0\\u4e0b\\uff1a' + b.textContent);
      } else {
        say('\\u6ca1\\u8bb0\\u4e0a\\uff1a' + ((o.j && o.j.error) || o.s), true);
      }
    }).catch(function(err){ b.disabled = false; say('' + err, true); });
  });

  // Reading is silent, and the server can only see requests: a long report is
  // one GET and then nothing at all, so an idle clock that watches the wire
  // counts the most careful reader as the one who walked away. The page says
  // otherwise itself — but only when it is actually being looked at. The timer
  // keeps ticking in a hidden tab (browsers throttle it to a crawl anyway);
  // what stops is the REQUEST, in the one gate below, so a backgrounded window
  // or another desktop leaves the idle clock running from the last thing a
  // human really did, and the reader exits on schedule as it always has.
  // Closing the page takes the timer with it. The ping carries the same
  // one-shot token as everything else, asks for nothing, and cannot outlast the
  // absolute ceiling — the watchdog checks that before it looks at the clock.
  //
  // And it gives up. A reader whose server has already exited is a tab that
  // would otherwise knock on a loopback port forever — a port the OS will hand
  // to some unrelated local service sooner or later, and the knock carries this
  // page's token in its query string. Three consecutive failures stop the timer
  // for good. Three and not one, so a single hiccup cannot end the keepalive;
  // and by the third the loopback has been refusing for three whole intervals —
  // the entire idle window wherever the interval is idle/3, three minutes at
  // the 60s cap. Nothing on 127.0.0.1 does that except a process that has gone.
  var kaTimer = 0, kaMiss = 0;
  function kaStop(){ if (kaTimer) { clearInterval(kaTimer); kaTimer = 0; } }
  function kaMissed(){ if (++kaMiss >= 3) kaStop(); }
  function ping(){
    if (document.visibilityState !== 'visible') return;
    fetch('/alive?t=' + encodeURIComponent(t), {cache: 'no-store'})
      .then(function(r){ if (r.ok) { kaMiss = 0; } else { kaMissed(); } })
      .catch(kaMissed);
  }
  document.addEventListener('visibilitychange', function(){ if (kaTimer) ping(); });
  kaTimer = setInterval(ping, __KA__ * 1000);
})();
"""


def render(md, truncated, issue, nonce, keepalive):
    blocks, _ = parse_blocks(md.split("\n"))
    body = sections_html(blocks)
    warn = ('<div class="warn">报告超过 %d 字节,已截断显示;完整内容仍在服务器上。</div>'
            % MAX_REPORT) if truncated else ""
    foot = ('<div class="foot">%s · 本页只在本机 127.0.0.1 上,闲置后自动关闭。</div>'
            % _esc(issue))
    # int() and not the caller's value verbatim: the only thing that reaches the
    # page is a number this program computed, so the placeholder cannot become a
    # way to write javascript into the one script the CSP nonce trusts.
    js = JS.replace("__KA__", str(int(keepalive)))
    return ("<!doctype html>\n<html lang=\"zh\">\n<head>\n"
            "<meta charset=\"utf-8\">\n"
            "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n"
            "<meta name=\"referrer\" content=\"no-referrer\">\n"
            "<title>%s</title>\n<style nonce=\"%s\">%s</style>\n</head>\n<body>\n"
            "<main>%s%s</main>\n%s\n<div id=\"toast\" class=\"toast\"></div>\n"
            "<script nonce=\"%s\">%s</script>\n</body>\n</html>\n"
            % (_esc(issue), nonce, CSS, warn, body, foot, nonce, js))


# ---------------------------------------------------------------- http
class Handler(BaseHTTPRequestHandler):
    server_version = "pervio-view"
    sys_version = ""

    def log_message(self, *a):
        pass                      # a reader must be silent; stdout is the JSON line

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body if isinstance(body, bytes) else body.encode("utf-8")
        try:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Content-Security-Policy", CSP)
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)
        except OSError:
            pass

    def _err(self, code, msg):
        self._send(code, json.dumps({"ok": False, "error": msg}, ensure_ascii=False))

    def _authed(self):
        """Every request carries the one-shot token or gets nothing. Also the
        only place the idle clock is reset — an unauthenticated knock from
        anything else on the box must not keep the reader alive."""
        got = urllib.parse.parse_qs(
            urllib.parse.urlsplit(self.path).query).get("t", [""])[0]
        got = got.encode("ascii", "replace").decode("ascii")
        if not hmac.compare_digest(got, TOKEN):
            self._err(403, "forbidden")
            return False
        LAST[0] = time.time()
        return True

    def do_GET(self):
        if not self._authed():
            return
        path = urllib.parse.urlsplit(self.path).path
        if path == "/alive":
            # The open page's keepalive. Its entire job is the line ABOVE this
            # one: _authed() has already moved LAST[0], the single place in this
            # program where the idle clock is touched, and it did so only
            # because the token matched. Everything else about this branch is
            # deliberately nothing — no body is read, no file is named, no
            # command is built, and the answer carries twelve bytes that are the
            # same for every reader and every report. A caller who holds the
            # token could keep the reader alive with GET "/" anyway; this is
            # only the cheap way to do it. A caller who does not never reaches
            # here, and the 403 above leaves the clock where it was.
            self._send(200, json.dumps({"ok": True}))
            return
        if path.startswith("/fig/"):
            fid = path[len("/fig/"):]
            if not re.match(r"^\d{4}\.\d{4,5}$", fid):
                self._err(404, "not found")
                return
            import glob as _glob
            hits = _glob.glob(os.path.join(FIG_DIR, fid + ".*"))
            if not hits:
                self._err(404, "not found")
                return
            ext = os.path.splitext(hits[0])[1].lower()
            ctype = {".png": "image/png", ".jpg": "image/jpeg",
                     ".jpeg": "image/jpeg", ".gif": "image/gif",
                     ".webp": "image/webp"}.get(ext, "application/octet-stream")
            try:
                with open(hits[0], "rb") as f:
                    self._send(200, f.read(), ctype)
            except OSError:
                self._err(404, "not found")
            return
        if path != "/":
            self._err(404, "not found")
            return
        self._send(200, PAGE, "text/html; charset=utf-8")

    def do_POST(self):
        if not self._authed():
            return
        if urllib.parse.urlsplit(self.path).path != "/score":
            self._err(404, "not found")
            return
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if length < 0 or length > MAX_BODY:
            self._drain(length)
            self._err(413, "body too large")
            return
        raw = self.rfile.read(length) if length else b""
        try:
            req = json.loads(raw.decode("utf-8"))
        except Exception:
            self._err(400, "malformed request")
            return
        if not isinstance(req, dict):
            self._err(400, "malformed request")
            return
        # ONLY these three keys are read. A body carrying "command"/"run"/"argv"
        # is not rejected, it is simply irrelevant — there is no code path that
        # could ever look at it.
        ai = req.get("actionIndex")
        cg = req.get("captureGroups")
        ci = req.get("choiceIndex")
        if isinstance(ai, bool) or isinstance(ci, bool):
            self._err(400, "actionIndex/choiceIndex must be numbers")
            return
        if not (isinstance(ai, int) and 0 <= ai < len(ACTIONS)):
            self._err(400, "unknown action")
            return
        act = ACTIONS[ai]
        menu = act["menu"]
        if not (isinstance(ci, int) and 0 <= ci < len(menu)):
            self._err(400, "choice is not on this action's menu")
            return
        if not (isinstance(cg, list) and all(isinstance(x, str) for x in cg)):
            self._err(400, "captureGroups must be strings")
            return
        if not _argv_safe(cg):
            self._err(400, "a capture group would arrive as a flag")
            return
        if (ai, tuple(cg)) not in HITS:
            self._err(400, "capture groups do not match this report")
            return
        argv = _build_argv(act["toks"], list(cg), menu[ci])
        with INFLIGHT_LOCK:
            INFLIGHT[0] += 1
        try:
            rc, out, err = _run_argv(argv)
        finally:
            with INFLIGHT_LOCK:
                INFLIGHT[0] -= 1
            LAST[0] = time.time()
        self._send(200 if rc == 0 else 502, json.dumps(
            {"ok": rc == 0, "rc": rc, "output": out.strip(),
             "error": (err or out).strip()[:400] if rc != 0 else ""},
            ensure_ascii=False))

    def _drain(self, length):
        left = min(max(length, 0), 8_000_000)
        while left > 0:
            chunk = self.rfile.read(min(left, 65536))
            if not chunk:
                break
            left -= len(chunk)


# ---------------------------------------------------------------- lifecycle
def _watchdog(idle, deadline):
    """Self-owned: this thread lives inside the served process, so it fires
    whether the caller is still attached, gone, or never existed.

    A scoring command still running is not idleness — a click at second 599 of
    a 600s window must not have its write killed halfway, and since each command
    is capped at 30s the wait it can add is bounded. The ABSOLUTE ceiling is not
    negotiable that way: it fires in flight or not, and a command caught by it
    is simply left to finish on its own (it is a separate process; what dies
    here is only our ability to report its result)."""
    while True:
        time.sleep(0.25)
        now = time.time()
        if now >= deadline or (INFLIGHT[0] == 0 and now - LAST[0] >= idle):
            _drop_pidfile()
            os._exit(0)


def _start_watchdog(idle, deadline):
    _wd = threading.Thread(target=_watchdog, args=(idle, deadline), daemon=True)
    _wd.start()


def _install_signals():
    def bye(signum, frame):
        _drop_pidfile()
        os._exit(0)
    for s in (signal.SIGTERM, signal.SIGINT):
        try:
            signal.signal(s, bye)
        except (ValueError, OSError):
            pass


def _silence_stdio():
    fd = os.open(os.devnull, os.O_RDWR)
    for target in (0, 1, 2):
        try:
            os.dup2(fd, target)
        except OSError:
            pass
    if fd > 2:
        os.close(fd)


def _raise_on_desktop(url):
    """Hand the address to the Mac's default browser.

    Verified 2026-08-07 through a real NON-INTERACTIVE ssh exec channel (the
    same shape the phone uses): `open` reaches the GUI session and the page
    appears. `-g` keeps the browser from stealing focus — you asked for the
    report, not for your foreground app to change.

    Best-effort by design: the JSON line with the url is printed either way, so
    a machine where this fails (a Linux server, a locked screen) still gives the
    phone something to show. Never raises.
    """
    if sys.platform != "darwin":
        return False, "not macOS"
    try:
        p = subprocess.run(["open", "-g", url], stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE, timeout=10)
    except (OSError, subprocess.SubprocessError) as e:
        return False, str(e)[:120]
    if p.returncode != 0:
        return False, (p.stderr or b"").decode("utf-8", "replace").strip()[:120]
    return True, ""


# ---------------------------------------------------------------- cli
def parse_args(argv):
    o = {"dir": "", "file": "", "latest": False, "idle": IDLE_DEFAULT,
         "detach": False, "open": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--latest", "--detach", "--open"):
            o[a[2:]] = True
            i += 1
        elif a in ("--dir", "--file", "--idle") and i + 1 < len(argv):
            o[a[2:]] = argv[i + 1]
            i += 2
        else:
            _die("unknown/malformed arg: %s" % a)
    if not o["dir"].strip():
        _die("--dir is required")
    if o["file"] and o["latest"]:
        _die("--file and --latest are mutually exclusive")
    try:
        o["idle"] = int(o["idle"])
    except (TypeError, ValueError):
        _die("--idle must be a whole number of seconds")
    if o["idle"] < 1:
        _die("--idle must be at least 1 second")
    o["idle"] = min(o["idle"], HARD_CAP)
    return o


def resolve_issue(o):
    d = os.path.realpath(os.path.expanduser(o["dir"]))
    if not os.path.isdir(d):
        _die("no such archive dir: %s" % o["dir"])
    if o["file"]:
        if not FILE_RE.match(o["file"]):
            _die("--file must be a plain dated name like 2026-08-06.md")
        path = os.path.join(d, o["file"])
        if os.path.dirname(os.path.realpath(path)) != d or not os.path.isfile(path):
            _die("no such issue in that dir: %s" % o["file"])
        return d, path
    names = []
    for fn in os.listdir(d):
        if not FILE_RE.match(fn):
            continue
        p = os.path.join(d, fn)
        try:
            # The SAME containment gate --file enforces. A symlink in the archive
            # dir is a file from OUTSIDE it wearing an issue's name; --latest
            # picking it by mtime would serve that file on a port, so whoever can
            # write this directory must not be able to choose what is read.
            if os.path.dirname(os.path.realpath(p)) != d or not os.path.isfile(p):
                continue
            names.append((os.path.getmtime(p), p))
        except OSError:
            continue
    if not names:
        _die("that archive dir has no issues yet: %s" % o["dir"])
    names.sort(key=lambda x: (-x[0], x[1]))
    return d, names[0][1]


def read_report(path):
    try:
        with open(path, "rb") as f:
            raw = f.read(MAX_REPORT + 1)
    except OSError as e:
        _die("cannot read the issue: %s" % e)
    truncated = len(raw) > MAX_REPORT
    if truncated:
        raw = raw[:MAX_REPORT]
    text = raw.decode("utf-8", "replace")
    if truncated:
        text = text[:text.rfind("\n") + 1] if "\n" in text else text
    return text, truncated


def main(argv):
    global TOKEN, PAGE, ACTIONS, CSP
    o = parse_args(argv)
    d, path = resolve_issue(o)
    md, truncated = read_report(path)
    ACTIONS = _load_actions(d)
    TOKEN = secrets.token_urlsafe(32)
    nonce = base64.b64encode(os.urandom(16)).decode("ascii")
    CSP = ("default-src 'none'; script-src 'nonce-%s'; style-src 'nonce-%s'; "
           "connect-src 'self'; img-src 'self' https://arxiv.org; "
           "base-uri 'none'; form-action 'none'; "
           "frame-ancestors 'none'" % (nonce, nonce))
    keepalive = _keepalive_secs(o["idle"])
    PAGE = render(md, truncated, os.path.basename(path), nonce,
                  keepalive).encode("utf-8")

    try:
        srv = _LoopbackServer(("127.0.0.1", 0), Handler)
    except OSError as e:
        _die("cannot bind a loopback port: %s" % e)
    srv.daemon_threads = True
    port = srv.server_address[1]
    line = {"url": "http://127.0.0.1:%d/?t=%s" % (port, TOKEN),
            "pid": os.getpid(), "expiresIn": o["idle"],
            # Advertised so a caller can reason about the window without reading
            # the page: expiresIn is how long silence is tolerated, keepalive is
            # how often an open page breaks it. Neither moves the 60-minute
            # ceiling, which is the only number that is never negotiable.
            "keepalive": keepalive}
    LAST[0] = time.time()
    deadline = time.time() + HARD_CAP

    if not o["detach"]:
        _claim(port)
        _install_signals()
        _start_watchdog(o["idle"], deadline)
        if o["open"]:
            ok, why = _raise_on_desktop(line["url"])
            line["opened"] = ok
            if not ok:
                line["openError"] = why
        sys.stdout.write(json.dumps(line) + "\n")
        sys.stdout.flush()
        try:
            srv.serve_forever(poll_interval=0.2)
        except KeyboardInterrupt:
            pass
        finally:
            _drop_pidfile()
        return 0

    # --detach: the launcher (an ssh exec channel, typically) must get its JSON
    # line and exit, while the server lives on in its own session. The child
    # signals readiness down a pipe first, so the caller can never be handed a
    # url that nothing is listening on yet.
    r_fd, w_fd = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(r_fd)
        try:
            os.setsid()
        except OSError:
            pass
        try:
            signal.signal(signal.SIGHUP, signal.SIG_IGN)
        except (ValueError, OSError):
            pass
        _claim(port)
        _install_signals()
        _start_watchdog(o["idle"], deadline)
        try:
            os.write(w_fd, b"1")
        except OSError:
            pass
        os.close(w_fd)
        _silence_stdio()
        try:
            srv.serve_forever(poll_interval=0.2)
        finally:
            _drop_pidfile()
        os._exit(0)

    os.close(w_fd)
    ready = b""
    try:
        if select.select([r_fd], [], [], 20)[0]:
            ready = os.read(r_fd, 1)
    except OSError:
        ready = b""
    os.close(r_fd)
    if not ready:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
        _die("the detached server did not come up")
    line["pid"] = pid
    if o["open"]:
        # After readiness, so the browser never races the listener; and from the
        # PARENT, so the `open` subprocess belongs to a process that is about to
        # exit rather than to the long-lived server.
        ok, why = _raise_on_desktop(line["url"])
        line["opened"] = ok
        if not ok:
            line["openError"] = why
    sys.stdout.write(json.dumps(line) + "\n")
    sys.stdout.flush()
    os._exit(0)          # never run the parent's cleanup — the child owns it now


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
