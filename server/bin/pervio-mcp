# ---------- dynamic named tools (F3): one tool per exposed template ----------

def _param_type_ok(ptype, v):
    """Value-vs-declared-type check. bool first (int subclass); integer keeps
    _int_arg's tolerance for integral floats (some clients send 3.0)."""
    if ptype == "boolean":
        return isinstance(v, bool)
    if ptype == "integer":
        return not isinstance(v, bool) and (
            isinstance(v, int) or (isinstance(v, float) and v == int(v)))
    return isinstance(v, str)


def _valid_params(decl):
    """Validate a wrapper's params declaration; returns a normalized list or
    raises ValueError (the whole template is then skipped, with a stderr line —
    a broken declaration must not break the other named tools)."""
    if decl is None:
        return []
    if not isinstance(decl, list):
        raise ValueError("params must be a list")
    out, seen = [], set()
    for i, p in enumerate(decl):
        if not isinstance(p, dict):
            raise ValueError("params[%d] must be an object" % i)
        name = p.get("name")
        if not isinstance(name, str) or not PARAM_NAME_RE.match(name):
            raise ValueError("params[%d] name %r is invalid" % (i, name))
        if name == "dir":                       # collides with the ever-present dir arg
            raise ValueError("param name 'dir' is reserved")
        if name in seen:
            raise ValueError("duplicate param name %r" % name)
        seen.add(name)
        label = p.get("label")
        if not isinstance(label, str) or not label.strip():
            raise ValueError("param %r needs a label" % name)
        desc = p.get("description")
        if desc is not None and not isinstance(desc, str):
            raise ValueError("param %r description must be a string" % name)
        ptype = p.get("type", "string")
        if ptype not in PARAM_TYPES:
            raise ValueError("param %r type must be string|integer|boolean" % name)
        req = p.get("required", False)
        if not isinstance(req, bool):
            raise ValueError("param %r required must be a boolean" % name)
        norm = {"name": name, "label": label, "description": desc or "",
                "type": ptype, "required": req}
        if "default" in p:
            if not _param_type_ok(ptype, p["default"]):
                raise ValueError("param %r default doesn't match type %s" % (name, ptype))
            # Normalize NOW: _param_type_ok tolerates an integral float (JSON
            # 3.0) for integer params, but the default fills into values raw —
            # explicit values get int()-coerced, so the default must match, or
            # the tool's default path ships a float downstream (and the schema
            # renders "默认 3.0").
            norm["default"] = (int(p["default"]) if ptype == "integer"
                               else p["default"])
        out.append(norm)
    return out


def _dynamic_tools():
    """Scan ~/.pervio/templates FRESH (every tools/list and every named
    tools/call — the chat may rewrite templates concurrently; reading at use
    time keeps list and call consistent with the same disk state). Wrapper files
    with "expose": true become pervio_run_<slug> tools; bad slug / bad params /
    duplicate name skip THAT template with one stderr line; filename order,
    capped at DYN_CAP named tools. Returns an ordered dict name -> tool."""
    tools = {}
    try:
        names = sorted(fn for fn in os.listdir(TPL) if fn.endswith(".json"))
    except OSError:
        return tools
    over_cap = 0
    for fn in names:
        try:
            with open(os.path.join(TPL, fn), "r", errors="replace") as f:
                raw = json.load(f)
        except (OSError, ValueError):
            continue                            # broken JSON: cmd_templates already surfaces it
        if not isinstance(raw, dict) or raw.get("expose") is not True:
            continue
        if raw.get("kind") == "playbook":
            # A playbook loads into a conversation; it has nothing to RUN, so
            # expose:true on one can never mint a pervio_run_* tool.
            sys.stderr.write("pervio-mcp: %s: kind==playbook cannot be exposed "
                             "as a named tool — skipped\n" % fn)
            continue
        if not isinstance(raw.get("spec"), dict):
            # Only a WRAPPER can expose — a bare spec has no wrapper to declare on.
            sys.stderr.write("pervio-mcp: %s: expose needs a {name,summary,spec} "
                             "wrapper — skipped\n" % fn)
            continue
        slug = raw.get("slug")
        if not isinstance(slug, str) or not SLUG_RE.match(slug):
            sys.stderr.write("pervio-mcp: %s: expose without a valid slug "
                             "(^[a-z][a-z0-9_]{0,31}$) — skipped\n" % fn)
            continue
        name = DYN_PREFIX + slug
        if name in TOOLS or name in tools:      # first-by-filename wins a slug clash
            sys.stderr.write("pervio-mcp: %s: tool name %s already taken — skipped\n"
                             % (fn, name))
            continue
        try:
            params = _valid_params(raw.get("params"))
        except ValueError as e:
            sys.stderr.write("pervio-mcp: %s: bad params declaration (%s) — skipped\n"
                             % (fn, e))
            continue
        if len(tools) >= DYN_CAP:
            over_cap += 1
            continue
        props = {}
        for p in params:
            d = p["label"] + ((":" + p["description"]) if p["description"] else "")
            if "default" in p:
                d += "(默认 %s)" % json.dumps(p["default"], ensure_ascii=False)
            props[p["name"]] = {"type": p["type"], "description": d}
        props["dir"] = {"type": "string", "description": "覆盖模板 spec.dir(可选)"}
        summary = raw.get("summary")
        summary = summary if isinstance(summary, str) and summary.strip() else \
            str(raw.get("name") or slug)
        tools[name] = {
            "file": fn,
            "spec": raw["spec"],
            "params": params,
            "description": summary + SPEND + ETIQUETTE,
            "inputSchema": {"type": "object", "properties": props,
                            "required": [p["name"] for p in params if p["required"]]},
        }
    if over_cap:
        sys.stderr.write("pervio-mcp: %d exposed template(s) beyond the %d-named-tool "
                         "cap — skipped\n" % (over_cap, DYN_CAP))
    return tools


def _plan_dynamic(name, args):
    """What a named template tool would run: the template re-read from disk
    (resolve-at-call), the arguments checked against the wrapper's declaration,
    defaults filled, parameters substituted by orchestrate itself."""
    tool = _dynamic_tools().get(name)
    if tool is None:
        raise ToolError("unknown tool: %r" % name)
    decl = {p["name"]: p for p in tool["params"]}
    unknown = sorted(k for k in args if k != "dir" and k not in decl)
    if unknown:
        raise ToolError("unknown parameter(s): %s (declared: %s)"
                        % (", ".join(unknown), ", ".join(decl) or "(none)"))
    values = {}
    for pname, p in decl.items():
        if pname in args:
            v = args[pname]
            if not _param_type_ok(p["type"], v):
                raise ToolError("parameter %s must be a %s" % (pname, p["type"]))
            values[pname] = int(v) if p["type"] == "integer" else v
        elif "default" in p:
            values[pname] = p["default"]
        elif p["required"]:
            raise ToolError("missing required parameter: %s" % pname)
    spec = tool["spec"]
    saved_dir = spec.get("dir")
    d = args.get("dir")
    if d is not None:
        if not isinstance(d, str) or not d.strip():
            raise ToolError("dir must be a non-empty string")
        spec = dict(spec)
        spec["dir"] = d                         # orchestrate re-validates (no '..' etc.)
    # Always pass the values (even {}): the leftover probe then rejects any
    # stray {{param. in the spec instead of letting it reach a step verbatim.
    return _final(spec, values), TEMPLATE, saved_dir


def _call_dynamic(name, args):
    """tools/call for a named template tool -> {wfId}."""
    return _launch(_go(_plan_dynamic(name, args)))


def _resolve_call(tool, args):
    """The approval tool's question (`pervio-mcp --resolve`): what would this
    call run? A dict for the phone's sheet — {"spec_b64", "sha"} when the call
    carries a workflow, {} when it carries none (a pause, a delete, feedback) —
    or a ToolError, the same refusal the call itself would meet, so the person
    is never asked to allow what would be turned down anyway."""
    extra = None
    if tool == "pervio_start":
        plan = _plan_start(args)
    elif tool == "pervio_rerun":
        plan = _plan_rerun(args)
    elif tool == "pervio_schedule":
        _action, spec, extra = _plan_schedule(args)
        if spec is None:
            return {}
        plan = (spec, MODEL, None)
    elif isinstance(tool, str) and tool.startswith(DYN_PREFIX):
        plan = _plan_dynamic(tool, args)
    else:
        return {}
    spec, origin, saved_dir = plan
    _hold_to_ceiling(spec, origin, saved_dir)
    return {"spec_b64": _b64_json(spec), "sha": _sha(spec, extra)}


def _resolve_main():
    """`pervio-mcp --resolve`: {"tool", "input"} on stdin, one JSON line out —
    {"ok": true, ...} or {"ok": false, "error": words}."""
    try:
        req = json.loads(sys.stdin.read() or "null")
        tool, args = req.get("tool"), req.get("input")
        if args is None:
            args = {}
        if not isinstance(args, dict):
            raise ToolError("arguments must be an object")
        out = dict(_resolve_call(tool, args), ok=True)
    except ToolError as e:
        out = {"ok": False, "error": str(e)}
    except Exception as e:                       # never a traceback where one JSON line is expected
        out = {"ok": False, "error": "could not work out what this call would run: %s" % str(e)[:200]}
    sys.stdout.write(json.dumps(out, ensure_ascii=False) + "\n")


def _handle_call(mid, params):
    name = params.get("name")
    args = params.get("arguments")
    if args is None:
        args = {}
    if not isinstance(args, dict):
        # A tool-level shape error stays a tool-level isError (the call reached a
        # real method), but it must be NAMED — letting a list through reached the
        # tool body and surfaced a raw AttributeError as "internal error".
        _send({"jsonrpc": "2.0", "id": mid, "result": {
            "content": [{"type": "text", "text": "arguments must be an object"}],
            "isError": True}})
        return
    if RO_MODE and name not in RO_TOOLS:
        # Read-only mount: the gate sits BEFORE any resolution or argument
        # validation, so a write verb dies here even with perfectly valid
        # arguments. Known write verbs and ANY pervio_run_*-shaped name get the
        # read-only refusal (a named tool always spends — no disk scan needed
        # to know it's off-limits); a genuinely unknown name falls through to
        # the unknown-tool error below, keeping policy denials distinguishable
        # from typos. Execution only ever happens via the exact-match paths
        # below, so nothing a client sends can route around this return.
        if name in TOOLS or (isinstance(name, str) and name.startswith(DYN_PREFIX)):
            _send({"jsonrpc": "2.0", "id": mid, "result": {
                "content": [{"type": "text",
                             "text": "read-only mount: %s unavailable" % name}],
                "isError": True}})
            return
    tool = TOOLS.get(name)
    if tool is not None:
        fn = tool["fn"]
    elif isinstance(name, str) and name.startswith(DYN_PREFIX):
        fn = lambda a: _call_dynamic(name, a)   # noqa: E731 — resolve-at-call
    else:
        _send({"jsonrpc": "2.0", "id": mid, "result": {
            "content": [{"type": "text", "text": "unknown tool: %r" % name}],
            "isError": True}})
        return
    try:
        data = fn(args)
    except ToolError as e:
        _send({"jsonrpc": "2.0", "id": mid, "result": {
            "content": [{"type": "text", "text": str(e)}], "isError": True}})
        return
    except Exception as e:                       # a tool bug must never kill the server
        _send({"jsonrpc": "2.0", "id": mid, "result": {
            "content": [{"type": "text", "text": "internal error: %s" % str(e)[:300]}],
            "isError": True}})
        return
    text = data if isinstance(data, _RawText) else json.dumps(data, ensure_ascii=False)
    _send({"jsonrpc": "2.0", "id": mid, "result": {
        "content": [{"type": "text", "text": text}]}})


def _invalid(mid, why):
    """JSON-RPC -32600. Sent with id null when the message carried no usable id
    (the spec's answer for an unidentifiable request) so a client waiting on a
    reply learns the shape was wrong instead of hanging."""
    _send({"jsonrpc": "2.0", "id": mid,
           "error": {"code": -32600, "message": "invalid request: " + why}})


def _dispatch(msg):
    """One decoded stdin message -> at most one response.

    Every field is shape-checked BEFORE use. Syntactically valid JSON with the
    wrong shape (a top-level array, `method: 5`, `params: []`) used to reach
    `msg.get`/`method.startswith`/`params.get` and raise AttributeError out of
    main(), killing the process — and a dead stdio mount takes all 11 tools out
    of a live chat session with no error the client can show. Batches are a
    deliberate -32600: this server answers one message per line."""
    if not isinstance(msg, dict):
        _invalid(None, "message must be a JSON object")
        return
    mid = msg.get("id")
    if not (mid is None or isinstance(mid, (str, int, float))):
        _invalid(None, "id must be a string, number or null")
        return
    method = msg.get("method")
    if not isinstance(method, str):
        _invalid(mid, "method must be a string")
        return
    if method.startswith("notifications/"):
        return                                   # notifications get no response
    params = msg.get("params")
    if params is None:
        params = {}
    if not isinstance(params, dict):
        # No method here takes positional params, so a list/scalar is a shape
        # error. It used to be silently coerced to {} (falsy `[]`) or crash.
        _invalid(mid, "params must be an object")
        return
    if method == "initialize":
        pv = params.get("protocolVersion")
        _send({"jsonrpc": "2.0", "id": mid, "result": {
            "protocolVersion": pv if isinstance(pv, str) else "2024-11-05",
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "perviotools", "version": "1.0.0"}}})
    elif method == "tools/list":
        # Static eleven first (their names/schemas never change), then the
        # named template tools, re-scanned fresh on every list. Read-only
        # mount: exactly the seven read-only tools — write verbs unlisted
        # AND the template scan skipped entirely (named tools always
        # spend), so list and call agree on the same shrunken surface.
        if RO_MODE:
            srcs = ({n: TOOLS[n] for n in RO_TOOLS},)
        else:
            srcs = (TOOLS, _dynamic_tools())
        _send({"jsonrpc": "2.0", "id": mid, "result": {"tools": [
            {"name": n, "description": t["description"], "inputSchema": t["inputSchema"]}
            for src in srcs for n, t in src.items()]}})
    elif method == "tools/call":
        _handle_call(mid, params)
    elif method == "ping":
        # MCP spec: a ping MUST get an empty result — an error here would
        # let a future health-checking client mark the server dead.
        _send({"jsonrpc": "2.0", "id": mid, "result": {}})
    else:
        if mid is not None:
            _send({"jsonrpc": "2.0", "id": mid, "error": {
                "code": -32601, "message": "method not found: %s" % method}})


def main():
    while True:
        line = sys.stdin.readline()
        if line == "":                           # EOF: client gone
            break
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except Exception:
            continue                             # bad line never exits the process
        try:
            _dispatch(msg)
        except Exception as e:
            # Last-resort per-message boundary: NOTHING one message does may end
            # the loop. The client still gets an answer (a silent drop would hang
            # a caller that is waiting on this id).
            sys.stderr.write("pervio-mcp: message dropped (%s)\n" % str(e)[:200])
            try:
                _send({"jsonrpc": "2.0",
                       "id": msg.get("id") if isinstance(msg, dict) else None,
                       "error": {"code": -32603,
                                 "message": "internal error: %s" % str(e)[:200]}})
            except Exception:
                pass


if __name__ == "__main__":
    if sys.argv[1:2] == ["--resolve"]:
        _resolve_main()
    else:
        main()
