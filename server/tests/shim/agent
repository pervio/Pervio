#!/usr/bin/env python3
"""Committed test shim for Cursor's `agent`. pervio-chat runs it as
`agent -p [--mode plan|--force] [--resume <id>] [--model m] --output-format
stream-json --stream-partial-output --trust <prompt>`; a `SHIM:{json}` line in
the prompt drives behavior (same protocol as the claude shim; SHIM_CURSOR_JSON /
SHIM_CURSOR_TEXT from the env as fallbacks). Emits CURSOR-shaped events exactly as
agent 2026.10.14 does (probed 2026-10-14): system/init, the user echo, thinking
deltas, assistant text, a tool_call started/completed pair per `trace` tool, and
the result. A `models` subcommand answers like `agent models`."""
import json
import os
import sys
import time

if os.environ.get("SHIM_ARGV_LOG"):
    try:
        with open(os.environ["SHIM_ARGV_LOG"], "a") as _f:
            _f.write(json.dumps(sys.argv) + "\n")
    except OSError:
        pass

args = sys.argv[1:]
if os.environ.get("SHIM_ENV_LOG"):
    try:
        with open(os.environ["SHIM_ENV_LOG"], "a") as _f:
            _f.write(json.dumps({"argv": sys.argv[1:2], "store": os.environ.get("AGENT_CLI_CREDENTIAL_STORE", ""),
                                 "key": bool(os.environ.get("CURSOR_API_KEY"))}) + "\n")
    except OSError:
        pass
# SHIM_CURSOR_NEED_FILESTORE=1: behave like the real agent on a Mac whose keychain
# is locked for SSH — only the file credential store (or an API key) gets through.
if (os.environ.get("SHIM_CURSOR_NEED_FILESTORE") and os.environ.get("AGENT_CLI_CREDENTIAL_STORE") != "file"
        and not os.environ.get("CURSOR_API_KEY")):
    sys.stderr.write("Error: Your macOS login keychain is locked.\nRun \x1b[36msecurity unlock-keychain\x1b[0m and try again.\n")
    sys.exit(1)
if args[:1] == ["models"]:
    # SHIM_CURSOR_NEED_KEY=1: answer like the real agent with its keychain login
    # out of reach — only a CURSOR_API_KEY in the env unlocks the list.
    if os.environ.get("SHIM_CURSOR_NEED_KEY") and not os.environ.get("CURSOR_API_KEY"):
        sys.stderr.write("Run \x1b[36msecurity unlock-keychain\x1b[0m and try again\n")
        sys.exit(1)
    print("Available models\n\nauto - Auto (default)\ngpt-5.3-codex - Codex 5.3\ncomposer-2.5 - Composer 2.5")
    sys.exit(0)
if args[:1] == ["status"]:
    print("✓ Logged in as shim@example.com")
    sys.exit(0)
if args[:1] == ["login"]:
    # Like the real agent with NO_OPEN_BROWSER: the link, then waiting on the
    # browser. The test signals the person's sign-in by creating the file named
    # in SHIM_CURSOR_LOGIN_DONE; SHIM_CURSOR_LOGIN_FAIL makes the login die.
    print("Starting login process...\nAuthenticating with Cursor...\nWaiting for browser authentication...", flush=True)
    print("Open a browser and navigate to this link: https://cursor.com/loginDeepControl?challenge=shim-%d&uuid=shim&mode=login" % os.getpid(), flush=True)
    if os.environ.get("SHIM_CURSOR_LOGIN_FAIL"):
        print("Error: login failed (shim)", flush=True)
        sys.exit(1)
    done = os.environ.get("SHIM_CURSOR_LOGIN_DONE", "")
    for _ in range(300):
        if done and os.path.exists(done):
            break
        time.sleep(0.2)
    else:
        print("Error: timed out waiting for browser authentication", flush=True)
        sys.exit(1)
    d = os.path.join(os.path.expanduser("~"), ".cursor")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "auth.json"), "w") as f:
        f.write('{"accessToken": "shim-access", "refreshToken": "shim-refresh"}')
    os.chmod(os.path.join(d, "auth.json"), 0o600)
    print("✓ Logged in as shim@example.com\nAuthentication tokens stored securely.", flush=True)
    sys.exit(0)

# the prompt is the last positional (anything not a flag value)
flags_with_value = {"--resume", "--model", "--output-format", "--mode", "--workspace"}
prompt = ""
i = 0
while i < len(args):
    a = args[i]
    if a in flags_with_value and i + 1 < len(args):
        i += 2
        continue
    if a.startswith("-"):
        i += 1
        continue
    prompt = a
    i += 1
if os.environ.get("SHIM_PROMPT_LOG"):
    try:
        with open(os.environ["SHIM_PROMPT_LOG"], "a") as _f:
            _f.write(prompt + "\n===PROMPT-END===\n")
    except OSError:
        pass

ins = {}
for line in prompt.splitlines():
    line = line.strip()
    if line.startswith("SHIM:"):
        try:
            ins = json.loads(line[5:])
        except ValueError:
            pass
if not ins and os.environ.get("SHIM_CURSOR_JSON"):
    try:
        ins = json.loads(os.environ["SHIM_CURSOR_JSON"])
    except ValueError:
        pass
if "text" not in ins and os.environ.get("SHIM_CURSOR_TEXT"):
    ins["text"] = os.environ["SHIM_CURSOR_TEXT"]

# {"die": "<stderr text>", "rc": 1}: the agent dies before emitting anything —
# the real one does this when its keychain login is locked for an SSH session.
if ins.get("die"):
    sys.stderr.write(str(ins["die"]) + "\n")
    sys.exit(int(ins.get("rc") or 1))

sid = ins.get("sid", "cursor-shim-session")
resume = None
for i, a in enumerate(args):
    if a == "--resume" and i + 1 < len(args):
        resume = args[i + 1]
if resume:
    sid = resume


def emit(o):
    sys.stdout.write(json.dumps(o) + "\n")
    sys.stdout.flush()


emit({"type": "system", "subtype": "init", "apiKeySource": "login", "cwd": os.getcwd(),
      "session_id": sid, "model": "Auto", "permissionMode": "plan" if "--mode" in args else "default"})
emit({"type": "user", "message": {"role": "user", "content": [{"type": "text", "text": prompt}]}, "session_id": sid})
emit({"type": "thinking", "subtype": "delta", "text": "thinking…", "session_id": sid, "timestamp_ms": 1})
emit({"type": "thinking", "subtype": "completed", "session_id": sid, "timestamp_ms": 2})

for n, step in enumerate(ins.get("trace", [])):
    if "tool" in step:
        cid = "call-%d\nfc_%d" % (n, n)
        tool = step["tool"]
        if tool == "Bash":
            tc = {"shellToolCall": {"args": {"command": step.get("command", "ls"), "workingDirectory": "", "timeout": 30000}}}
            done = {"shellToolCall": {"args": tc["shellToolCall"]["args"], "result": {"success": {"stdout": step.get("out", "ok")}}}}
        elif tool == "Task":
            # A sub-agent, in the shapes of a real cursor-agent turn (2026-11-22):
            # args with the description and {"<type>": {}} for its type, a result
            # that is the sub-agent's steps and a durationMs STRING. "fail" ends it in error.
            targs = {"description": step.get("description", "Sub task"), "prompt": step.get("prompt", "do it"),
                     "subagentType": {step.get("type", "unspecified"): {}}, "model": "default", "agentId": "agent-%d" % n}
            tc = {"taskToolCall": {"args": targs}}
            res = ({"error": {"message": step["fail"]}} if step.get("fail") else
                   {"success": {"conversationSteps": [{"assistantMessage": {"text": "working on it"}},
                                                      {"assistantMessage": {"text": step.get("out", "sub done")}}],
                                "agentId": "agent-%d" % n, "isBackground": False, "durationMs": str(step.get("ms", 4709))}})
            done = {"taskToolCall": {"args": targs, "result": res}}
        else:
            tc = {"editToolCall": {"args": {"path": step.get("file_path", "/tmp/x.txt"), "streamContent": step.get("content", "hi")}}}
            done = {"editToolCall": {"args": tc["editToolCall"]["args"], "result": {"success": {"path": step.get("file_path", "/tmp/x.txt")}}}}
        emit({"type": "tool_call", "subtype": "started", "call_id": cid, "tool_call": tc, "session_id": sid})
        emit({"type": "tool_call", "subtype": "completed", "call_id": cid, "tool_call": done, "session_id": sid})
    else:
        emit({"type": "assistant", "message": {"role": "assistant", "content": [{"type": "text", "text": step.get("say", "")}]}, "session_id": sid})
    time.sleep(float(ins.get("trace_gap", 0.05)))

for w in ins.get("write", []):
    d = os.path.dirname(w["file"])
    if d:
        os.makedirs(d, exist_ok=True)
    with open(w["file"], "w") as f:
        f.write(w["content"])

if ins.get("sleep"):
    time.sleep(float(ins["sleep"]))

text = ins.get("text", "ok")
emit({"type": "assistant", "message": {"role": "assistant", "content": [{"type": "text", "text": text}]}, "session_id": sid})
emit({"type": "result", "subtype": "error" if ins.get("is_error") else "success", "duration_ms": 5, "duration_api_ms": 5,
      "is_error": bool(ins.get("is_error")), "result": text, "session_id": sid, "request_id": "req-shim",
      "usage": {"inputTokens": 100, "outputTokens": 10, "cacheReadTokens": 0, "cacheWriteTokens": 0}})
sys.exit(1 if ins.get("rc") else 0)
